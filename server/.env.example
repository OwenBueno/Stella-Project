# Atlas (production / cloud):
# DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/stella?retryWrites=true&w=majority"
# Local standalone MongoDB (dev):
DATABASE_URL="mongodb://127.0.0.1:27017/stella?retryWrites=false&directConnection=true"
API_KEY="change-me-to-a-long-random-string"
PORT=3000
NODE_ENV=development
# Max JSON request body size (Express default is 100kb; sync push chunks need more)
REQUEST_BODY_LIMIT=512kb

# Phase 3 — FCM (path to service account JSON, or inline JSON)
# FCM_SERVICE_ACCOUNT_JSON="/path/to/firebase-service-account.json"

# Phase 4 — AI assistant (OpenRouter; server only — never commit real keys)
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
# OPENROUTER_MODEL_FALLBACK="deepseek/deepseek-v4-flash"
# OPENROUTER_HTTP_REFERER="https://your-domain.com"
# OPENROUTER_APP_NAME="Stella"

# Dev scripts (from server/):
# npm run db:seed              — insert fake test data
# npm run db:seed -- --clean-first  — wipe Stella collections then seed
# npm run db:clean -- --confirm     — delete all Stella entity collections
